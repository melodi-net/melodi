# Meshtastic radio serial ports.
#
# Grants access via the logind ACL (uaccess) and the plugdev group, so no
# dialout membership or re-login is needed.
#
# udev cannot rename a tty node, so /dev/ttyACM* still exists; these are
# symlinks. ttyMEL%n follows the kernel's ACM index, ttyMEL-<serial> is stable
# across replug and renumbering.

ACTION!="add|change", GOTO="melodi_end"
SUBSYSTEM!="tty", GOTO="melodi_end"

# Raspberry Pi RP2040 — Pico, RAK11310
ATTRS{idVendor}=="2e8a", ENV{MELODI_RADIO}="1"
# Silicon Labs CP210x — Heltec, T-Beam, most ESP32 boards
ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ENV{MELODI_RADIO}="1"
# WCH CH340 / CH9102
ATTRS{idVendor}=="1a86", ENV{MELODI_RADIO}="1"
# Espressif native USB — ESP32-S3, ESP32-C3
ATTRS{idVendor}=="303a", ENV{MELODI_RADIO}="1"
# Nordic nRF52 — RAK4631, T-Echo
ATTRS{idVendor}=="239a", ENV{MELODI_RADIO}="1"
# Seeed — XIAO nRF52840
ATTRS{idVendor}=="2886", ENV{MELODI_RADIO}="1"
# STM32 virtual COM port
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ENV{MELODI_RADIO}="1"

ENV{MELODI_RADIO}=="1", MODE="0660", GROUP="plugdev", TAG+="uaccess", \
    SYMLINK+="ttyMEL%n"
ENV{MELODI_RADIO}=="1", ENV{ID_SERIAL_SHORT}=="?*", \
    SYMLINK+="ttyMEL-$env{ID_SERIAL_SHORT}"

LABEL="melodi_end"
